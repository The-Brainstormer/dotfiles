# git
alias gs="git status"
alias ga="git add"
alias gaa="git add ."
alias gap="git add -p"

alias gcm="git commit -m"
alias gcob="git checkout -b"

alias gs="git switch"

alias gpull="git pull"
alias gpm="git pull origin main"
alias gpush="git push"
alias gpfwl="git push --force-with-lease"

alias unstage="git restore --staged"
alias reset-last="git reset --soft HEAD^"

alias stash-unstaged="git stash push --keep-index -u"

# work-specific
alias dev="just dev-tmux-web"
alias integration="make dev-tmux-integration"
alias gentypes="turbo generate-types"
alias typecheck="turbo typecheck"
alias typecheck-web="turbo typecheck -F web-client"
alias make-types="turbo generate-types"
alias story="just dev-storybook"
alias test="make unit-test"
alias do-pull="git pull && yarn post-pull && make dev-tmux-web"
